# Base de données SQLite (chemin relatif à la racine du projet)
DATABASE_URL="./data/app.db"

# Better Auth
# Générer un secret : `openssl rand -base64 32`
BETTER_AUTH_SECRET="remplacez-moi-par-un-secret-aleatoire"
BETTER_AUTH_URL="http://localhost:3017"

# URL publique de l'application (utilisée côté client)
NEXT_PUBLIC_APP_URL="http://localhost:3017"

# Fournisseurs OAuth (optionnels : laisser vide pour désactiver le bouton)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
